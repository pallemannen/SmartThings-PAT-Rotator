# ── Samsung account ────────────────────────────────────────────────────────
SAMSUNG_EMAIL=you@example.com
SAMSUNG_PASSWORD=your_samsung_password

# TOTP base32 secret — leave blank if you don't use authenticator-app 2FA
# To find it: when setting up 2FA, Samsung shows a QR code; the secret is
# the base32 string encoded in that QR code.  You can also read it from your
# authenticator app (e.g. in Aegis: long-press entry → Edit → show secret).
SAMSUNG_TOTP_SECRET=

# ── Home Assistant ─────────────────────────────────────────────────────────
# Your HA instance URL (no trailing slash)
HA_URL=http://homeassistant.local:8123

# Long-lived access token — Profile → Security → Long-Lived Access Tokens
HA_TOKEN=your_ha_long_lived_token

# The input_text entity that the integration reads the PAT from
HA_ENTITY_ID=input_text.smartthings_pat

# ── Internal ───────────────────────────────────────────────────────────────
# Where the Docker volume is mounted inside the container; don't change this
# unless you also change the volumes: section in docker-compose.yml
STATE_FILE=/data/browser_state.json
